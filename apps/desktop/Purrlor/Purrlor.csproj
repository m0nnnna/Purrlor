<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version is for Windows notifications (Toasts.cs); Purrlor needs Windows 10 1809 or later. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>purrlor.ico</ApplicationIcon>
    <AssemblyName>Purrlor</AssemblyName>
    <RootNamespace>Purrlor</RootNamespace>
    <Platforms>x64</Platforms>
    <!-- The one version number: Build-Purrlor.ps1 reads it for the installer and the release. -->
    <Version>1.2.0</Version>
    <Product>Purrlor</Product>
    <Company>MeowOps</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44" />
    <Content Include="purrlor.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
