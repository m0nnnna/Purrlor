# Token server — proxy to the Purrlor LiveKit token endpoint, as a separate vhost.
# Copy to e.g. token.yourdomain.com.conf, or fold into a location block on the app's own vhost.
# Token server listens on 3001; CORS is handled by the service itself (ALLOWED_ORIGINS in .env).
# Proxying "/" wholesale means this also covers /api/gifs/* (GIF search, optional — see
# KLIPY_API_KEY in .env.example) with nothing extra to add here.

server {
    listen 443 ssl http2;
    server_name token.YOUR_DOMAIN;

    ssl_certificate /path/to/ssl/fullchain.pem;
    ssl_certificate_key /path/to/ssl/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Optional: HTTP redirect to HTTPS
# server {
#     listen 80;
#     server_name token.YOUR_DOMAIN;
#     return 301 https://$server_name$request_uri;
# }
