# Nginx reverse proxy — all-in-one example (web app + token server + push gateway + LiveKit)
# fronting the docker-compose.yml stack in this directory. Copy, replace YOUR_DOMAIN and the SSL
# paths. It's what deploy/setup.sh writes, minus the bundled-homeserver blocks.
#
# The token server and push gateway are served under the app's own address (/api/livekit/ and
# /api/push/), so the whole thing needs only two names: app. and livekit. — and those two paths
# are what .env's PURRLOR_TOKEN_ENDPOINT and PURRLOR_PUSH_GATEWAY_URL point at. (Older installs
# gave each its own subdomain; token.nginx.conf.example and push.nginx.conf.example still show
# that layout, and it works just as well.)
#
# app.YOUR_DOMAIN is Purrlor's own web client — deliberately not "chat." or "matrix.", so it
# doesn't collide with wherever your *existing* Matrix homeserver already lives (see
# docs/deployment.md's "Scope" section — Purrlor is a client, not a homeserver).

# Bots that unfurl links (Discord, Bluesky, iMessage, Slack…) get a shared /@name link's preview
# card from the token server; people get the app (docs/public-web.md).
map $http_user_agent $purrlor_unfurl {
    default 0;
    ~*(discordbot|twitterbot|facebookexternalhit|slackbot|telegrambot|whatsapp|linkedinbot|cardyb|bluesky|mastodon|embedly|iframely|redditbot|skypeuripreview|vkshare|pinterest|google-pagerenderer) 1;
}

server {
    listen 443 ssl http2;
    server_name app.YOUR_DOMAIN;

    ssl_certificate /path/to/ssl/fullchain.pem;
    ssl_certificate_key /path/to/ssl/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/livekit/ {
        proxy_pass http://127.0.0.1:3001/api/livekit/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The public web (docs/public-web.md): read-only answers for people who aren't signed in.
    location /api/public/ {
        proxy_pass http://127.0.0.1:3001/api/public/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # A profile page or post link: the app, except for bots unfurling it, who get its preview card.
    location ~ ^/@[^/]+(/post/[^/]+|/(music|art|commissions)/[A-Za-z0-9_-]+(/[0-9]+)?)?$ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        if ($purrlor_unfurl) {
            rewrite ^/@[^/]+/post/([^/]+)$ /api/public/card/post/$1 break;
            rewrite ^/@([^/]+)/((music|art|commissions)/.+)$ /api/public/card/$1/$2 break;
            rewrite ^/@([^/]+)$ /api/public/card/$1 break;
            proxy_pass http://127.0.0.1:3001;
        }
        proxy_pass http://127.0.0.1:8080;
    }

    # The trailing slashes strip the prefix: /api/push/subscribe reaches the gateway as /subscribe.
    location /api/push/ {
        proxy_pass http://127.0.0.1:3002/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name livekit.YOUR_DOMAIN;

    ssl_certificate /path/to/ssl/fullchain.pem;
    ssl_certificate_key /path/to/ssl/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}

server {
    listen 80;
    server_name app.YOUR_DOMAIN livekit.YOUR_DOMAIN;
    return 301 https://$host$request_uri;
}
