    "livekit-server-sdk": "^2.0.0",
    "matrix-js-sdk": "41.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "20.14.2",
    "eslint": "^9.39.5",
    "tsx": "4.16.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.70.1"
  }
}
